# =============================================================================
# Smart Recipe Planner — Backend Environment Variables
# Copy this file to .env and fill in the values below.
# =============================================================================

# --- Database ---
# SQLite (default, zero-config for local dev)
DATABASE_URL=sqlite+aiosqlite:///./data.db
# PostgreSQL example (swap in for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recipe_db

# --- Auth ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_in_production

# --- Spoonacular (recipe data source) ---
# Required for live recipe fetching. Leave empty to use mock recipe data.
SPOONACULAR_API_KEY=

# =============================================================================
# Open-Source LLM / VLM via Ollama  (recommended for local dev on Ubuntu/WSL)
# Run scripts/setup_ollama.sh to install Ollama and pull the required models.
#
# Models used:
#   VLM  — qwen3-vl:4b  (vision-language, ingredient recognition from photos)
#   LLM  — qwen3:4b     (4 B params, fits ~3 GB VRAM; text reasoning + structured JSON)
#
# Both endpoints point at the same Ollama server; the model name selects the task.
# Ollama exposes an OpenAI-compatible /v1 endpoint so no code changes are needed.
# =============================================================================

# --- VLM (ingredient recognition from photos) ---
# Set to empty string to use mock ingredient data (no Ollama required).
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=qwen3-vl:4b
VLM_API_KEY=local
VLM_TIMEOUT_SECONDS=10

# --- LLM (recipe ideation + re-ranking) ---
# Set to empty string to skip LLM steps and use keyword fallback.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=local
LLM_TIMEOUT_SECONDS=30

# --- Ranking mode ---
# hybrid     = rule scorer → top 15 → LLM re-ranker (default, best quality)
# rules_only = deterministic only, no LLM call (fastest, no GPU needed)
# llm_only   = all 40 candidates go straight to the LLM ranker
RANKING_MODE=hybrid
